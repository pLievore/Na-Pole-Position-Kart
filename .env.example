# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha os valores. O .env NUNCA vai pro git.
# ---------------------------------------------------------------------------

# Supabase Postgres. Copie as strings pelo botao Connect do projeto.
# Runtime/Vercel: Transaction pooler (Supavisor), porta 6543.
DATABASE_URL="postgresql://prisma.PROJECT_REF:SENHA@HOST_POOLER:6543/postgres?pgbouncer=true&sslmode=require"

# Prisma CLI/migrations: conexao direta, porta 5432. Se a rede nao tiver IPv6,
# use o Session pooler do Supavisor, tambem na porta 5432.
DIRECT_URL="postgresql://prisma:SENHA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Limite por instancia do servidor. Ajuste somente com observabilidade.
DATABASE_POOL_MAX="5"

# Este projeto nao usa SUPABASE_URL, publishable key nem secret key: o acesso e
# feito exclusivamente pelo servidor, por meio das URLs Postgres acima.

# Segredo de sessao/JWT. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# URL publica do site (usada em links de e-mail e metadados)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp da operacao, usado no botao "Chamar no WhatsApp" (formato E.164, sem +)
NEXT_PUBLIC_WHATSAPP="5511999999999"

# Seed inicial. Nunca envie a senha por chat nem a versione.
SEED_ADMIN_EMAIL="admin@napoleposition.com.br"
SEED_ADMIN_SENHA=""
SEED_KARTS="10"
