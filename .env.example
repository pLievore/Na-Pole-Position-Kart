# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha os valores. O .env NUNCA vai pro git.
# ---------------------------------------------------------------------------

# Postgres gerenciado (Neon ou Supabase).
# DATABASE_URL -> conexao usada pela aplicacao (pode ser pooled).
DATABASE_URL="postgresql://usuario:senha@host/napole?sslmode=require"

# DIRECT_URL (opcional) -> conexao direta, usada pelas migrations quando a
# DATABASE_URL passa por um pooler. Sem pooler, pode deixar em branco.
# DIRECT_URL="postgresql://usuario:senha@host/napole?sslmode=require"

# Segredo de sessao/JWT. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# URL publica do site (usada em links de e-mail e metadados)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp da operacao, usado no botao "Chamar no WhatsApp" (formato E.164, sem +)
NEXT_PUBLIC_WHATSAPP="5511999999999"
