{
  "name": "@napole/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma e cliente de banco da Na Pole Position.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "//build": "O cliente Prisma e gerado, nao versionado. Sem isto o build na Vercel quebra ao importar @napole/db.",
    "build": "prisma generate",
    "//postinstall": "Garante o cliente logo apos a instalacao, qualquer que seja o comando de build configurado.",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "studio": "prisma studio",
    "seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@napole/auth": "workspace:^",
    "@napole/core": "workspace:*",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
